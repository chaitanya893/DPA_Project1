# Database Configuration
# Default uses SQLite for instant local zero-setup execution, or set your PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/earnings_call_db
DATABASE_URL=sqlite:///earnings_call.db

# HTTP Scraper Configuration (Required by PDF Compliance)
# User-Agent format: ProjectName/1.0 (Contact: user@domain.com)
USER_AGENT=EarningsCallCaptureBot/1.0 (Contact: research_intern@domain.com)
RATE_LIMIT_DELAY_SECONDS=2.5
REQUEST_TIMEOUT_SECONDS=15
